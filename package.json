{
  "name": "laplante",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm --workspace @laplante/server run dev",
    "test": "vitest run",
    "typecheck": "npm --workspaces run typecheck",
    "build": "npm --workspace @laplante/shared run build && npm --workspace @laplante/server run build && npm --workspace @laplante/web run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.6.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6"
  }
}
